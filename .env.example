# TelegramFlow — environment template
# Copy to .env and fill in values: cp .env.example .env

# --- Application ---
ENVIRONMENT=development
DEBUG=true
ENABLE_ADMIN_API=true

# --- PostgreSQL ---
POSTGRES_USER=teleflow
POSTGRES_PASSWORD=teleflow
POSTGRES_DB=teleflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://teleflow:teleflow@localhost:5432/teleflow
DATABASE_URL_SYNC=postgresql://teleflow:teleflow@localhost:5432/teleflow

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Backend / Frontend ---
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Telegram Engine: Hydrogram (Pyrogram-compatible, official PyPI) ---
TELEGRAM_ENGINE=hydrogram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSIONS_DIR=/data/sessions

# Smart-Shield delays (seconds). For E2E use 3-8 instead of 30-120.
SMART_SHIELD_MIN_DELAY=30
SMART_SHIELD_MAX_DELAY=120

# --- LLM: DeepSeek по умолчанию; переключение: deepseek | openai ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Billing: CryptoBot ---
CRYPTOBOT_TOKEN=

# --- Telegram Bot (маркетплейс рекламы + вход через Login Widget) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BACKEND_INTERNAL_URL=http://backend:8000
